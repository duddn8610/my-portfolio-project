    },
    {
      "parameters": {
        "jsCode": "const gitlabIssue = $node['GitLab_event_alert 및 redmine 연동'].json.body.object_attributes;\nconst redmineIssues = $input.all().map(item => item.json);\n\n// 이슈 배열이 비었는지 확인\nif (!redmineIssues || redmineIssues.length === 0) {\n  throw new Error(`GitLab 이슈 ID ${gitlabIssue.iid}에 연결된 Redmine 이슈를 찾을 수 없습니다.`);\n}\n\nconst redmineIssue = redmineIssues[0];\n\n// 업데이트 데이터 준비\nconst updateData = {\n  issue: {\n    subject: gitlabIssue.title,\n    description: gitlabIssue.description\n  }\n};\n\n// 최종 반환 (반드시 배열로 반환해야 함)\nreturn [{ json: updateData }];\n"
      },
      "type": "n8n-nodes-base.code",
