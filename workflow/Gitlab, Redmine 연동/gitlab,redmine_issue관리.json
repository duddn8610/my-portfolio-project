      "id": "6e658ad8-337f-40e0-8b52-33029dda3d3b",
      "name": "Update Issue Code"
    },
    {
      "parameters": {
        "jsCode": "const inputData = $input.all()[0].json;\nconst gitlabIssue = $node['GitLab_event_alert 및 redmine 연동'].json.body.object_attributes;\nconst redmineIssue = inputData.issue;\n\n// 연결 확인\nif (!redmineIssue) {\n  throw new Error(`GitLab 이슈 ID ${gitlabIssue.iid}에 연결된 Redmine 이슈를 찾을 수 없습니다.`);\n}\n\n// 업데이트 데이터 준비\nconst updateData = {\n  issue: {\n    status_id: 6,\n    done_ratio: 100\n  }\n};\n\n// 반환 (모든 데이터 json 내부에 포함)\nreturn [{\n  json: {\n    updateData,\n    redmine_issue_id: redmineIssue.id,\n    gitlab_issue_id: gitlabIssue.iid,\n    action: 'close'\n  }\n}];\n"
      },
