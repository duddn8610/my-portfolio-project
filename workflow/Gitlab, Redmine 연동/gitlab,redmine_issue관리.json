    {
      "parameters": {
        "jsCode": "// Slack 메시지에서 GitLab ↔ Redmine 이슈 번호 쌍 추출 + 중복 제거\nconst messages = $input.item.json.messages || [];\nconst issuePairs = [];\n\n// 중복 확인용 Set (gitlabId-redmineId 형식으로 저장)\nconst seen = new Set();\n\nfor (const message of messages) {\n  if (!message.text) continue;\n\n  // GitLab ID 추출\n  const gitlabMatch = message.text.match(/https:\\/\\/[^ ]+\\/issues\\/(\\d+)/);\n  const gitlabId = gitlabMatch ? parseInt(gitlabMatch[1]) : null;\n\n  // Redmine ID 추출\n  const redmineMatch = message.text.match(/https:\\/\\/rm\\.evolvesoft\\.cf\\/issues\\/(\\d+)/);\n  const redmineId = redmineMatch ? parseInt(redmineMatch[1]) : null;\n\n  if (gitlabId && redmineId) {\n    const key = `${gitlabId}-${redmineId}`;\n    if (!seen.has(key)) {\n      seen.add(key);\n      issuePairs.push({\n        json: {\n          gitlabId,\n          redmineId\n        }\n      });\n    }\n  }\n}\n\nreturn issuePairs;\n"
      },
