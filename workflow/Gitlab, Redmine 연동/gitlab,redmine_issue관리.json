    {
      "parameters": {
        "jsCode": "// 입력 데이터 가져오기\nconst inputData = $input.all()[0].json;\n\n// 기존 데이터를 복사\nconst outputData = JSON.parse(JSON.stringify(inputData));\n\n// username에 따라 점수 설정\nif (inputData.body.user.username === 'youngwoo.bang') {\n  outputData.body.user_username = 39;\n} else if (inputData.body.user.username === 'sangpil.park') {\n  outputData.body.user_username = 17;\n} else if (inputData.body.user.username === 'case2589') {\n  outputData.body.user_username = 40;\n} else {\n  outputData.body.user_username = 0;\n}\n\nreturn [{ json: outputData }];"
      },
