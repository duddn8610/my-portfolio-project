    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const binary = item.binary || {};\n  const binaryKeys = Object.keys(binary);\n  const hasFile = binaryKeys.length > 0;\n  const hasText = !!item.json.text;\n\n  let fileType = null;\n  if (hasFile) {\n    const mimeType = binary[binaryKeys[0]].mimeType;\n    if (mimeType.includes('pdf')) fileType = 'pdf';\n    else if (mimeType.includes('image')) fileType = 'image';\n    else fileType = 'other';\n  }\n\n  const chatroomId = item.json.chatroomId || 'defaultRoom';\n  const memoryData = item.json.chatMemory || {};\n  const isDeleteRequested = item.json.delete === true;\n\n  if (isDeleteRequested) {\n    // 삭제 요청 시 해당 채팅방 기록 삭제 (초기화)\n    memoryData[chatroomId] = [];\n    item.json.chatHistory = [];\n    // 삭제 완료 메시지 세팅\n    item.json.chatInput = \"삭제되었습니다.\";\n    item.json.sessionId = \"\";\n  }\n\n  // 필요에 따라 다른 필드 처리 가능\n\n  \n\n  return item;\n});\n"
      },
